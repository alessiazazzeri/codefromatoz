---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/contact.css';
import {contactNeeds as needs} from '../data/contact';
const next = [['SCRIVIMI', 'Mi racconti brevemente cosa hai in mente.'],['CAPIAMOCI', 'Ti rispondo e vediamo insieme se e come posso aiutarti.'],['DEFINIAMO', 'Se decidiamo di proseguire, raccogliamo con calma tutti i dettagli necessari e preparo il preventivo.']];
---
<Base title="Contact — Code from A to Z" description="Hai un progetto, un sito da rifare o semplicemente un'idea ancora un po' confusa? Raccontamela. Non serve arrivare con tutte le risposte.">
  <Header />
  <main id="main" class="contact-page">
    <section class="cp-hero" aria-labelledby="cp-title"><p class="eyebrow">01 / CONTACT</p><div class="cp-hero-grid"><h1 id="cp-title">TELL ME<br />WHAT'S ON<br /><em>YOUR MIND.</em></h1><div><p class="cp-lead">Hai un progetto, un sito da rifare o semplicemente un'idea ancora un po' confusa?</p><p class="cp-intro">Raccontamela. Non serve arrivare con tutte le risposte.</p><p class="cp-micro">NO PERFECT BRIEF REQUIRED.</p></div></div></section>
    <section class="cp-form-section" aria-labelledby="form-title"><div class="cp-form-intro"><p class="eyebrow">01 / THE FORM</p><h2 id="form-title">START<br /><em>ANYWHERE.</em></h2><p class="cp-setup-note" id="form-availability">Puoi contattarmi anche direttamente: <a href="mailto:info@codefromatoz.it">scrivimi via email</a>.</p></div>
      <form id="project-form" method="post" action="/api/contact" aria-labelledby="form-title" aria-describedby="form-availability" data-state="idle">
        <div id="form-errors" class="cp-errors" role="alert" tabindex="-1" hidden><p>Controlla questi campi:</p><ul></ul></div>
        <div class="cp-sr-only" aria-hidden="true"><label for="contact-confirm">Lascia vuoto questo campo</label><input id="contact-confirm" name="contact_confirm" type="text" tabindex="-1" autocomplete="off" data-honeypot /></div>
        <fieldset class="cp-fields" disabled><legend class="cp-sr-only">Raccontami il progetto</legend>
          <div class="cp-field"><label for="contact-name">Nome <span>(obbligatorio)</span></label><input id="contact-name" name="name" autocomplete="name" maxlength="120" required aria-describedby="contact-name-error" /><p id="contact-name-error" class="cp-field-error" hidden></p></div>
          <div class="cp-field"><label for="contact-email">Email <span>(obbligatorio)</span></label><input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="contact-email-error" /><p id="contact-email-error" class="cp-field-error" hidden></p></div>
          <div class="cp-field cp-wide"><label for="contact-need">Di cosa hai bisogno? <span>(obbligatorio)</span></label><select id="contact-need" name="need" required aria-describedby="contact-need-error"><option value="">Seleziona</option>{needs.map(value => <option value={value}>{value}</option>)}</select><p id="contact-need-error" class="cp-field-error" hidden></p></div>
          <aside class="cp-budget cp-wide" aria-labelledby="starting-price-title"><h3 id="starting-price-title">PROJECTS STARTING FROM €650</h3><p>Vuoi capire prima quanto può costare?</p><a class="cp-link" href="/services#numbers-title">VEDI I PREZZI <span aria-hidden="true">→</span></a></aside>
          <div class="cp-field cp-wide"><label for="contact-project">Raccontami in due righe cosa hai in mente <span>(obbligatorio)</span></label><textarea id="contact-project" name="project" rows="7" maxlength="4000" required placeholder="Anche un'idea ancora confusa va benissimo." aria-describedby="contact-project-error"></textarea><p id="contact-project-error" class="cp-field-error" hidden></p></div>
          <div class="cp-privacy cp-wide"><div><input id="contact-privacy" name="privacy" type="checkbox" required aria-describedby="contact-privacy-error privacy-note" /><label for="contact-privacy">Ho letto l'<a href="/privacy-policy">informativa privacy</a> e acconsento al trattamento dei dati per ricevere risposta alla mia richiesta.</label></div><p id="contact-privacy-error" class="cp-field-error" hidden></p><p id="privacy-note" tabindex="-1">L'informativa privacy è in preparazione.</p></div>
        </fieldset>
        <button class="cp-submit" type="submit" disabled>PARLIAMONE <span aria-hidden="true">→</span></button>
        <noscript><p class="cp-setup-note">Per usare la validazione del modulo è necessario JavaScript. Puoi scrivermi a <a href="mailto:info@codefromatoz.it">info@codefromatoz.it</a>.</p></noscript>
        <p class="cp-sending cp-form-status" role="status" aria-live="polite" hidden>SENDING...</p>
        <div class="cp-success cp-form-status" role="status" aria-live="polite" tabindex="-1" hidden><h3>GOT IT.</h3><p>Il messaggio è partito. Ti risponderò appena possibile.</p></div>
        <div class="cp-error cp-form-status" role="alert" tabindex="-1" hidden><h3>QUALCOSA NON HA FUNZIONATO.</h3><p>Riprova oppure <a href="mailto:info@codefromatoz.it">scrivimi direttamente via email</a>.</p></div>
      </form>
    </section>
    <section class="cp-direct" aria-labelledby="direct-title"><div><p class="eyebrow">03 / DIRECT CONTACT</p><h2 id="direct-title">MORE OF AN<br /><em>EMAIL PERSON?</em></h2></div><div><p>Va bene anche quello.</p><a href="mailto:info@codefromatoz.it">info@codefromatoz.it <span aria-hidden="true">↗︎</span></a></div></section>
    <section class="cp-next" aria-labelledby="cp-next-title"><div><p class="eyebrow">04 / WHAT HAPPENS NEXT</p><h2 id="cp-next-title">THEN<br /><em>WHAT?</em></h2></div><div><ol>{next.map(([title,text],index) => <li><h3>0{index+1} / {title}</h3><p>{text}</p></li>)}</ol><p class="cp-micro">NO MYSTERY PRICING. NO SURPRISE SCOPE.</p></div></section>
    <div class="cp-final-visual" role="img" aria-label="YOUR IDEA, dalla A alla Z"><span>YOUR IDEA</span><span aria-hidden="true">↓</span><strong>A <i>→</i> Z</strong></div>
  </main>
  <SiteFooter />
  <script src="../scripts/contact.ts"></script>
</Base>
