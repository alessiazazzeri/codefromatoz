---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BrandLogo from '../components/brand/BrandLogo.astro';
import LogoHeaderPreview from '../components/brand/LogoHeaderPreview.astro';
const directions = [{id:1 as const,title:'WORDMARK',description:'Due righe, una direzione: il nome apre la composizione, A → Z ne diventa la firma.'},{id:2 as const,title:'A/Z MARK',description:'Un segno compatto su una griglia rettangolare: A e Z separate da un taglio diagonale.'},{id:3 as const,title:'EDITORIAL MARK',description:'Il percorso scende da A a Z e si apre verso il nome. Una firma verticale, con ritmo editoriale.'}];
---
<Base title="Logo exploration — Code from A to Z"><Header /><main id="main" class="brand-lab"><div class="lab-intro"><p class="eyebrow">BRAND EXPLORATION / PREVIEW TEMPORANEA</p><h1>FROM A<br /><em>TO WHAT?</em></h1><p>Archivio delle tre direzioni esplorate. La variante 02C — Slash / Square è il logo ufficiale approvato.</p><p class="eyebrow">CODE FROM A TO Z / ALESSIA ZAZZERI / WEB DESIGNER + DEVELOPER</p></div>
  <section id="logo-directions" class="lab-section" aria-labelledby="directions-title"><h2 id="directions-title">01 / TRE DIREZIONI</h2><div class="direction-grid">{directions.map(direction => <article><p class="eyebrow">DIRECTION 0{direction.id}</p><h3>{direction.title}</h3><div class="isolated-logo"><BrandLogo direction={direction.id} /></div><p>{direction.description}</p>{direction.id===2 && <a class="refinement-link" href="/brand-exploration/a-z-mark">APPROFONDISCI A/Z →</a>}<div class="logo-swatch light"><BrandLogo direction={direction.id} /><span>NERO / CHIARO</span></div><div class="logo-swatch dark"><BrandLogo direction={direction.id} /><span>BIANCO / SCURO</span></div><div class="logo-scales">{[64,32,16].map(size => <div><div style={{width:`${size}px`,height:`${size}px`}}><BrandLogo direction={direction.id} /></div><span>{size}px</span></div>)}</div></article>)}</div></section>
  <section id="desktop-simulations" class="lab-section" aria-labelledby="desktop-sim-title"><h2 id="desktop-sim-title">02 / HEADER DESKTOP — TRE PROPOSTE</h2>{directions.map(direction => <div class="simulation-block"><p class="eyebrow">0{direction.id} / {direction.title}</p><LogoHeaderPreview direction={direction.id} /></div>)}</section>
  <section id="mobile-simulations" class="lab-section" aria-labelledby="mobile-sim-title"><h2 id="mobile-sim-title">03 / HEADER MOBILE — TRE PROPOSTE</h2><div class="mobile-simulations">{directions.map(direction => <div><p class="eyebrow">0{direction.id} / {direction.title}</p><LogoHeaderPreview direction={direction.id} mobile /></div>)}</div></section>
  <section id="header-preview" class="lab-section" aria-labelledby="header-preview-title"><h2 id="header-preview-title">04 / HEADER CONDIVISO — PREVIEW WORDMARK 01</h2><p class="lab-caption">Il wordmark 01 resta una simulazione di confronto. Il logo ufficiale del sito è la variante 02C.</p><Header previewLogo={1} idPrefix="brand-preview" /></section>
  <section id="footer-preview" aria-labelledby="footer-preview-title"><div class="lab-section footer-preview-heading"><h2 id="footer-preview-title">05 / FOOTER CONDIVISO</h2></div><SiteFooter /></section>
</main></Base>
<style>.lab-intro{padding:35px 3vw 45px;border-bottom:var(--line)}.lab-intro h1{font-size:clamp(65px,10vw,150px);margin:35px 0}.lab-intro h1 em{color:var(--blue)}.lab-intro>p:not(.eyebrow){font-size:20px;max-width:600px}.lab-intro>p:last-child{margin-top:25px;font-size:10px}.lab-section{padding:35px 3vw 45px;border-bottom:var(--line)}.lab-section>h2{font:700 12px/1.5 'Courier New',monospace;letter-spacing:.03em;margin-bottom:30px}.direction-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.direction-grid article{min-width:0}.direction-grid h3{font-size:26px;letter-spacing:-.06em;margin:12px 0 20px}.isolated-logo{height:220px;display:grid;place-items:center;border:var(--line);background:var(--purple);padding:40px;--proposal-accent:var(--blue)}.isolated-logo :global(svg){max-height:135px;max-width:260px}.direction-grid article>p:not(.eyebrow){font-size:13px;min-height:85px;padding:18px 0}.logo-swatch{height:150px;position:relative;padding:30px 40px 40px;display:flex;justify-content:center;align-items:center;border:var(--line)}.logo-swatch :global(svg){max-width:200px;max-height:95px}.logo-swatch span{position:absolute;bottom:12px;left:12px;font:9px 'Courier New',monospace}.light{color:#000;background:var(--paper)}.dark{color:#fff;background:var(--ink)}.logo-scales{display:flex;gap:25px;align-items:end;padding:25px 0}.logo-scales>div{display:flex;align-items:center;flex-direction:column;gap:10px}.logo-scales span{font:10px 'Courier New',monospace}.simulation-block+.simulation-block{margin-top:30px}.simulation-block>.eyebrow,.mobile-simulations .eyebrow{margin-bottom:14px}.mobile-simulations{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.lab-caption{font-size:13px;max-width:650px;margin-bottom:25px}.footer-preview-heading{padding-bottom:10px;border-bottom:0}@media(max-width:767px){.lab-intro,.lab-section{padding:28px 20px 35px}.lab-intro h1{font-size:17vw}.lab-intro>p:not(.eyebrow){font-size:17px}.direction-grid,.mobile-simulations{grid-template-columns:minmax(0,1fr)}.direction-grid{gap:35px}.isolated-logo{height:200px}.direction-grid article>p:not(.eyebrow){min-height:0}.logo-swatch{height:150px}.mobile-simulations{gap:30px}.lab-section>h2{font-size:11px}}.refinement-link{display:inline-block;font:700 11px/1.5 'Courier New',monospace;border-bottom:var(--line);padding:8px 0;margin-bottom:18px}</style>
