---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<Base title="404 — Pagina non trovata · Code from A to Z" description="Questa pagina non esiste. Torna alla homepage o esplora i progetti di Code from A to Z." noindex>
  <Header />
  <main id="main" class="not-found">
    <p class="eyebrow">404 / NOT FOUND</p>
    <h1>FROM A<br />TO… <em>WHERE?</em></h1>
    <p>Questa pagina non esiste.</p>
    <nav aria-label="Riprendi la navigazione"><a href="/">TORNA ALLA HOME →</a><a href="/work">ESPLORA I PROGETTI →</a></nav>
  </main>
  <SiteFooter />
</Base>
<style>
.not-found{padding:48px 3vw 70px;border-bottom:var(--line)}h1{font-size:clamp(52px,10vw,160px);margin:50px 0 32px}h1 em{color:var(--blue)}nav{display:flex;gap:24px;flex-wrap:wrap;margin-top:32px}nav a{font:700 12px 'Courier New',monospace;padding:16px 0;border-bottom:var(--line)}@media(max-width:600px){.not-found{padding:32px 20px 48px}h1{font-size:clamp(34px,10vw,60px)}nav{flex-direction:column;align-items:start;gap:12px}}
</style>
