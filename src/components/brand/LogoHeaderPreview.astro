---
import BrandLogo from './BrandLogo.astro';
interface Props { direction: 1 | 2 | 3; mobile?: boolean; }
const {direction,mobile=false}=Astro.props;
---
<div class:list={['logo-header-simulation',{mobile}]} aria-label={`Simulazione header ${mobile?'mobile':'desktop'}, direzione ${direction}`}><div class="sim-logo"><BrandLogo direction={direction} /></div>{mobile ? <span class="sim-menu">MENU ＋</span> : <div class="sim-navigation"><span>WORK</span><span>SERVICES</span><span>ABOUT</span><span>CONTACT ↗︎</span></div>}</div>
<style>.logo-header-simulation{display:flex;justify-content:space-between;align-items:stretch;border:var(--line);background:var(--paper);min-height:85px;color:var(--ink)}.sim-logo{display:grid;place-items:center;border-right:var(--line);padding:12px 24px;width:145px}.sim-logo :global(svg){width:90px;height:60px}.sim-navigation{display:flex;align-items:stretch}.sim-navigation>span{display:flex;align-items:center;padding:20px 2vw;border-left:var(--line);font:700 11px 'Courier New',monospace}.sim-navigation>span:last-child{background:var(--blue);color:var(--paper)}.mobile{width:375px;max-width:100%;min-height:82px}.mobile .sim-logo{width:115px;padding:10px 18px}.mobile .sim-logo :global(svg){width:82px;height:58px}.sim-menu{display:flex;align-items:center;justify-content:center;border-left:var(--line);font:700 11px 'Courier New',monospace;padding:20px;gap:20px}@media(max-width:767px){.logo-header-simulation:not(.mobile) .sim-logo{width:100px;padding:10px}.sim-navigation{flex-wrap:wrap;justify-content:end}.sim-navigation>span{font-size:8px;padding:12px 8px}.sim-logo :global(svg){width:70px;height:50px}}</style>
