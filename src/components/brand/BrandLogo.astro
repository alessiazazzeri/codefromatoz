---
interface Props { direction: 1 | 2 | 3; }
const { direction } = Astro.props;
---
{direction === 1 ? <svg class="brand-proposal" viewBox="0 0 240 112" fill="currentColor" aria-hidden="true"><text x="4" y="23" font-family="Arial, Helvetica, sans-serif" font-size="21" font-weight="700" letter-spacing="4">CODE FROM</text><text x="0" y="103" font-family="Arial, Helvetica, sans-serif" font-size="94" font-weight="900" letter-spacing="-7">A</text><path class="proposal-accent" d="M83 65h56l-15-15 6-6 28 26-28 26-6-6 15-15H83z"/><text x="166" y="103" font-family="Arial, Helvetica, sans-serif" font-size="94" font-weight="900">Z</text></svg> : direction === 2 ? <svg class="brand-proposal" viewBox="0 0 160 112" fill="currentColor" aria-hidden="true"><path d="M2 2h156v108H2z" fill="none" stroke="currentColor" stroke-width="3"/><text x="10" y="84" font-family="Arial, Helvetica, sans-serif" font-size="76" font-weight="900" letter-spacing="-5">A</text><path class="proposal-accent" d="M91 20h11L72 93H61z"/><text x="99" y="84" font-family="Arial, Helvetica, sans-serif" font-size="76" font-weight="900">Z</text></svg> : <svg class="brand-proposal" viewBox="0 0 260 112" fill="currentColor" aria-hidden="true"><text x="0" y="45" font-family="Arial, Helvetica, sans-serif" font-size="55" font-weight="900">A</text><path class="proposal-accent" d="M48 19h21v60h20l-12-12 5-5 23 23-23 23-5-5 12-12H60V27H48z"/><text x="0" y="108" font-family="Arial, Helvetica, sans-serif" font-size="55" font-weight="900">Z</text><text x="115" y="38" font-family="Arial, Helvetica, sans-serif" font-size="28" font-weight="900" letter-spacing="-1">CODE</text><text x="115" y="70" font-family="Arial, Helvetica, sans-serif" font-size="28" font-weight="900" letter-spacing="-1">FROM</text><text x="115" y="102" font-family="Arial, Helvetica, sans-serif" font-size="28" font-weight="900" letter-spacing="-1">A TO Z</text></svg>}
<style>.brand-proposal{display:block;width:100%;height:100%;overflow:visible}.proposal-accent{fill:var(--proposal-accent,currentColor)}</style>
