---
import CaseStudy from '../layouts/CaseStudy.astro';
import CaseStudyMedia from './CaseStudyMedia.astro';
import '../styles/visual-case-study.css';
export interface Props {
  composition?: "balanced" | "poster" | "gallery" | "split";
  number: string;
  title: [string, string];
  pageTitle: string;
  intro: string;
  tags: string;
  info: [string, string][];
  overview: { title: string[]; paragraphs: string[] };
  direction: { title: string[]; text: string; microcopy: string };
  result: { title: string[]; text: string };
  next: { number: string; title: string; slug: string; published: boolean };
}
const { composition = "balanced", number, title, pageTitle, intro, tags, info, overview, direction, result, next } = Astro.props;
---
<CaseStudy title={`${pageTitle} — Code from A to Z`} description={intro}>
  <div class={`visual-case visual-case--${composition}`}>
    <section class="case-hero" aria-labelledby="visual-title"><p class="eyebrow">{number} / CLIENT WORK</p><h1 id="visual-title">{title[0]}<br /><em>{title[1]}</em></h1><div class="case-hero-bottom"><p>{intro}</p><p class="case-tags">{tags}</p></div><CaseStudyMedia label={`${pageTitle.toUpperCase()} / VISUAL PRINCIPALE`} /></section>
    <section class={`case-info visual-info ${info.length === 3 ? "visual-info-three" : ""}`} aria-label="Project info"><dl>{info.map(([key,value]) => <div><dt>{key}</dt><dd>{value}</dd></div>)}</dl></section>
    <section class="case-section visual-overview" aria-labelledby="overview-title"><div><p class="eyebrow">01 / OVERVIEW</p><h2 id="overview-title">{overview.title.map((line,i) => <>{i>0 && <br />}{i===overview.title.length-1 ? <em>{line}</em> : line}</>)}</h2></div><div class="case-prose">{overview.paragraphs.map(text => <p>{text}</p>)}</div></section>
    <section class="case-section visual-direction" aria-labelledby="visual-direction-title"><div class="visual-direction-copy"><p class="eyebrow">02 / VISUAL DIRECTION</p><h2 id="visual-direction-title">{direction.title.map((line,i) => <>{i>0 && <br />}{i===direction.title.length-1 ? <em>{line}</em> : line}</>)}</h2><p class="case-prose">{direction.text}</p><p class="eyebrow visual-microcopy">{direction.microcopy}</p></div><CaseStudyMedia label="DIREZIONE VISIVA / DETTAGLI UI" variant="detail" /></section>
    <section class="case-section visual-gallery" aria-labelledby="gallery-title"><div class="visual-gallery-top"><h2 id="gallery-title">03 / GALLERY / MOCKUP</h2><span aria-hidden="true">↙︎</span></div><div class="visual-gallery-grid"><div class="visual-gallery-main"><CaseStudyMedia label="DESKTOP / MOCKUP" /></div><div class="visual-gallery-detail"><CaseStudyMedia label="MOBILE / DETTAGLIO" variant="detail" /></div></div></section>
    <section class="case-section visual-result" aria-labelledby="visual-result-title"><div><p class="eyebrow">04 / RESULT</p><h2 id="visual-result-title">{result.title.map((line,i) => <>{i>0 && <br />}{i===result.title.length-1 ? <em>{line}</em> : line}</>)}</h2></div><p class="case-prose">{result.text}</p></section>
    <section class="case-next visual-next" aria-labelledby="visual-next-title" data-next-project={`/work/${next.slug}`}><p class="eyebrow">NEXT PROJECT / {next.number}</p><h2 id="visual-next-title">{next.published ? <a href={`/work/${next.slug}`}>{next.title} <span aria-hidden="true">→</span></a> : <>{next.title} <span aria-hidden="true">→</span></>}</h2></section>
  </div>
</CaseStudy>
