---
import PortfolioImage from './PortfolioImage.astro';
import { projectImages } from '../data/project-images';
---
<section id="side-quest" class="side-quest section-anchor" aria-labelledby="side-quest-title">
  <div class="quest-copy">
    <p class="eyebrow quest-label">SIDE QUEST / 01 <span aria-hidden="true">↗︎</span></p>
    <h2 id="side-quest-title">BUBU <span>&amp;</span> SIBY</h2>
    <p class="quest-headline">Nessuno aveva bisogno di questo sito.<br />Quindi l'ho fatto.</p>
    <p class="quest-tags">CREATIVE CODING / WEB DESIGN / QUESTIONABLE PRIORITIES</p>
    <a class="quest-link" href="https://codefromatoz.github.io/bubu-siby/">ENTRA NEL LORO MONDO <span aria-hidden="true">→</span></a>
  </div>
  <div class="quest-visual">
    <div class="quest-screenshot">
      <div class="quest-window" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="quest-art quest-real"><PortfolioImage image={projectImages['bubu-siby']} sizes="(max-width: 600px) calc(100vw - 60px), 44vw" /></div>
    </div>
    <span class="quest-corner" aria-hidden="true">↙︎</span>
  </div>
</section>
<style>
  .quest-real{inset:26px 0 0 !important}
  .quest-real :global(.portfolio-image){width:100%;height:100%;object-fit:cover;object-position:center;display:block}

  .side-quest{display:grid;grid-template-columns:1.15fr 1fr;background:var(--purple);color:var(--ink);border-bottom:var(--line);overflow:hidden}
  .quest-copy{padding:34px 3vw 36px;position:relative;z-index:1}
  .quest-label{display:inline-flex;gap:32px;align-items:center;background:var(--ink);color:var(--paper);padding:9px 12px;transform:rotate(-2deg);margin-bottom:28px}
  .quest-label span,.quest-link span,.quest-star,.quest-corner{font-family:'DejaVu Sans',sans-serif;font-variant-emoji:text}
  h2{font-size:clamp(40px,5.6vw,84px);line-height:.95;letter-spacing:-.07em}
  h2 span{color:#162ba5}
  .quest-headline{font-size:clamp(17px,1.6vw,23px);letter-spacing:-.035em;line-height:1.3;margin-top:22px;max-width:470px}
  .quest-tags{font:700 10px/1.6 'Courier New',monospace;letter-spacing:.03em;margin-top:20px;max-width:430px}
  .quest-link{display:inline-flex;align-items:center;gap:24px;font:700 12px/1.4 'Courier New',monospace;border-bottom:var(--line);padding:10px 0 7px;margin-top:16px;transition:color .25s}
  .quest-link span{font-size:22px;line-height:1;transition:transform .3s}
  .quest-visual{display:grid;place-items:center;position:relative;padding:36px 4vw 36px 2vw}
  .quest-screenshot{width:100%;max-width:480px;aspect-ratio:1.55;border:var(--line);background:var(--paper);position:relative;transform:rotate(3deg);box-shadow:8px 8px 0 var(--ink);transition:transform .5s cubic-bezier(.2,.7,.2,1)}
  .quest-window{height:25px;border-bottom:var(--line);display:flex;align-items:center;gap:5px;padding:0 10px}
  .quest-window span{width:5px;height:5px;background:var(--ink);border-radius:50%}
  .quest-art{position:absolute;inset:26px 0 28px;display:grid;place-items:center;overflow:hidden}
  .quest-amp{font-size:clamp(90px,12vw,175px);line-height:1;font-family:Georgia,serif;font-style:italic;color:var(--blue);transform:rotate(-12deg)}
  .quest-orbit{position:absolute;width:70%;height:65%;border:1px solid var(--ink);border-radius:50%;transform:rotate(-22deg);background:var(--pink)}
  .quest-star{position:absolute;right:13%;top:8%;font-size:36px;line-height:1;color:var(--ink)}
  .quest-placeholder{position:absolute;bottom:10px;left:12px;font:700 9px/1 'Courier New',monospace;letter-spacing:.05em}
  .quest-corner{position:absolute;right:2vw;bottom:22px;font-size:44px;line-height:1;color:var(--ink)}
  .quest-link:focus-visible{outline-color:var(--ink);color:#162ba5}
  .quest-link:focus-visible span{transform:translateX(5px)}
  @media(hover:hover){.quest-link:hover{color:#162ba5}.quest-link:hover span{transform:translateX(5px)}.quest-visual:hover .quest-screenshot{transform:rotate(1deg) translateY(-3px)}}
  @media(max-width:1000px) and (min-width:601px){.side-quest{grid-template-columns:1.1fr 1fr}.quest-copy{padding-right:0}h2{font-size:5.5vw}.quest-headline{font-size:18px}.quest-tags{max-width:320px}.quest-corner{font-size:35px}}
  @media(max-width:600px){.side-quest{grid-template-columns:minmax(0,1fr)}.quest-copy{padding:28px 20px 12px}.quest-label{margin-bottom:25px}h2{font-size:clamp(36px,10.8vw,62px)}.quest-headline{font-size:19px;max-width:330px}.quest-tags{font-size:9px;max-width:320px}.quest-link{font-size:11px;margin-top:13px;gap:18px}.quest-visual{padding:24px 30px 38px}.quest-amp{font-size:110px}.quest-star{font-size:29px}.quest-corner{right:12px;bottom:15px;font-size:35px}.quest-screenshot{max-width:390px}}
  @media(prefers-reduced-motion:reduce){.quest-link:focus-visible span,.quest-link:hover span{transform:none}.quest-visual:hover .quest-screenshot{transform:rotate(3deg)}}
</style>
