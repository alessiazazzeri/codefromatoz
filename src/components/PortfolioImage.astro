---
import { Image } from 'astro:assets';
import type { PortfolioImage } from '../data/portfolio';
interface Props {
  image: PortfolioImage;
  sizes: string;
  priority?: boolean;
}
const { image, sizes, priority = false } = Astro.props;
const widths = [...new Set([480, 960, 1600, 2400, Math.min(2400, image.source.width)])].filter(width => width <= image.source.width).sort((a, b) => a - b);
---
<Image
  class="portfolio-image"
  src={image.source}
  alt={image.alt}
  width={Math.min(1600, image.source.width)}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={88}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : undefined}
  decoding="async"
  style={{ objectPosition: image.position ?? '50% 50%' }}
/>
