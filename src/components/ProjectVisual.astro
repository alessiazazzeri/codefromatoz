---
import { Image } from 'astro:assets';
import { fullPreviews } from '../data/full-previews';
import type { PortfolioImage as ProjectImage } from '../data/portfolio';
interface Props { image: ProjectImage; number: string; slug: string; context?: 'home' | 'index'; }
const { image, number, slug, context = 'index' } = Astro.props;
const source = fullPreviews[slug];
if (!source) throw new Error(`Missing verified full-width screenshot for ${slug}`);
const sizes = context === 'home'
  ? '(max-width: 600px) calc(100vw - 40px), (max-width: 1000px) 47vw, 24vw'
  : '(max-width: 600px) calc(100vw - 40px), 55vw';
const priority = context === 'index' && number === '01';
// The tallest existing frame is 3:4. Retain the full source width and only
// pre-trim pixels below that viewport, avoiding delivery of the entire page.
const previewHeight = Math.ceil(source.width * 4 / 3);
const widths = [...new Set([320, 480, source.width])].filter(width => width <= source.width);
---
<div class={`project-art has-image index-image index-image--${slug} index-image--${context}`}>
  <Image class="portfolio-image" src={source} alt={image.alt} width={source.width} height={previewHeight} widths={widths} sizes={sizes} fit="cover" position="top" format="webp" quality={88} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" />
  <span class="project-number image-number" aria-hidden="true">/{number}</span>
</div>
<style>
/* A viewport onto the real page: the full width is visible, only height clips.
   The build-time crop above has the same horizontal scale as the full source. */
.index-image :global(.portfolio-image){display:block;position:absolute;inset:0 auto auto 0;width:100%;height:auto;max-width:none;object-fit:initial;transform:none;transition:none}
.index-image .image-number{z-index:2}
</style>
